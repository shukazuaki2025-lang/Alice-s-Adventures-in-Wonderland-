{
  "name": "alice-adventures-in-wonderland-ch1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint .",
    "test": "node --import tsx/esm --test tests/unit/*.test.mjs tools/inspect-glb.mjs tools/check-carroll-fidelity.mjs tools/check-alice-rig.mjs",
    "test:e2e": "playwright test --project=chromium",
    "assets": "node tools/optimize-assets.mjs",
    "gate": "node tools/quality-gate.mjs",
    "gate:quick": "node tools/quality-gate.mjs --quick",
    "gate:check": "node tools/quality-gate.mjs --no-run",
    "check:assets": "node tools/check-assets.mjs",
    "test:gate-capture": "playwright test --project=gate"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.174.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.2.0"
  }
}
